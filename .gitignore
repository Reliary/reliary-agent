# Build artifacts
/target/
**/target/

# Cargo lockfiles (keep root one only)
/**/Cargo.lock
!/Cargo.lock

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Local index DBs
.reliary/
bench/.reliary/
bench/target/
**/__pycache__/

# Test work dirs
/test_work/
/r38_test/
/r38_test_work/

# OS files
.DS_Store
Thumbs.db
*.swp
*.bak

# IDE files
.idea/
.vscode/

# Node modules
**/node_modules/

# Bench result JSONL files
bench/results/*.jsonl

# V75 bench cassettes: replay artifacts are local by default.
# Public-corpus cassettes may be committed deliberately (see docs/plans/V75_CASSETTE_DETERMINISM.md).
# `cassettes/*` (not `cassettes/`) so the canonical tape below can be re-included:
# git cannot re-include a file if its parent directory is excluded.
bench/cassettes/*
# ...except the canonical public-corpus tape, which is committed so anyone can
# reproduce the headline benchmark with zero API calls (bench/replay_canonical.sh).
!bench/cassettes/canonical-v4/
